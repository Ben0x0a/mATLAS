# User data
out/
crash_reports/
# Local mATLAS config (copy from matlas_config.toml.example); only the example is tracked.
matlas_config.toml
# Presets (mATLAS-presets) and the AXIOM preset generator live in their own repo,
# cloned/placed here as a sibling checkout. See presets/README.md once cloned.
presets/

# Python-generated files
__pycache__/
*.py[oc]
*.egg
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
ENV/

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# Environment and version management
.python-version

# Logs and temporary files
*.log
.DS_Store
tasks/
# Internal documentation (decision narrative, review records, working notes) — kept local,
# out of the shipped docs so the published set stays clean of internal codes and audit trail
docs/internal/
# Local doc exports/archives: a zipped docs/ tree carries docs/internal/ INSIDE it, which
# would smuggle the internal set past the rule above on a careless `git add .`
docs.zip
docs*.zip

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Local performance/parity benchmark (not shipped)
benchmark/

# Runtime UFDR model-drift baseline (accumulated per deployment, not shipped)
ufdr_parser/model_signatures/baseline.db

# Legacy UFEDParser scripts, kept locally as a reference for the UFDR dump's combined
# workbook; not part of mATLAS and not shipped.
docs/legacy script/
